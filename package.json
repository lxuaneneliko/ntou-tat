{
  "name": "ntou-tat",
  "private": true,
  "version": "1.13.33",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-map-bundle.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync android && node scripts/verify-map-bundle.mjs android/app/src/main/assets/public",
    "ios:sync": "npm run build && cap sync ios && node scripts/verify-map-bundle.mjs ios/App/App/public",
    "ios:open": "cap open ios",
    "android:debug": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:install": "node scripts/install-android.mjs",
    "android:run": "node scripts/install-android.mjs"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "lucide-react": "^1.26.0",
    "maplibre-gl": "^6.10.0",
    "onnxruntime-web": "^1.27.0",
    "pako": "^3.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.2",
    "@types/pako": "^2.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10"
  }
}
