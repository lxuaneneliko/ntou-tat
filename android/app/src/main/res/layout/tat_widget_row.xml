<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="5dp" android:paddingBottom="5dp">
 <ImageView android:id="@+id/widget_course_accent" android:layout_width="4dp" android:layout_height="38dp" android:layout_marginEnd="10dp" android:background="#e8b44b" android:importantForAccessibility="no" />
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:id="@+id/widget_course_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#233340" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="3dp">
     <TextView android:id="@+id/widget_course_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6b7b88" android:textSize="11sp" />
     <TextView android:id="@+id/widget_course_room" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="#6b7b88" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
   </LinearLayout>
 </LinearLayout>
</LinearLayout>
